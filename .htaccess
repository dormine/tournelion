# Le site est servi depuis public/ (dossier racine OVH : www/public).
# Tout domaine qui pointe sur www/ (www.tournelion.com, domaine technique OVH)
# est redirigé vers le site : les fichiers du projet (.env.local…) ne sont jamais exposés.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ https://tournelion.com%{REQUEST_URI} [R=301,L]
</IfModule>
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
