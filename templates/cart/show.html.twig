{% extends 'base.html.twig' %}

{% block title %}Panier{% endblock %}

{% block body %}
    <h1>Panier</h1>

    {% if lines is empty %}
        <p>Votre panier est vide. <a href="{{ path('shop_index') }}">Découvrir la boutique</a></p>
    {% else %}
        <table class="cart">
            <thead>
                <tr><th>Produit</th><th>Prix</th><th>Quantité</th><th>Total</th></tr>
            </thead>
            <tbody>
                {% for line in lines %}
                    <tr>
                        <td><a href="{{ path('shop_product', {slug: line.product.slug}) }}">{{ line.product.name }}</a></td>
                        <td>{{ line.product.priceCents|price }}</td>
                        <td>
                            <form method="post" action="{{ path('cart_update', {id: line.product.id}) }}" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                                <input type="number" name="quantity" value="{{ line.quantity }}" min="0" {% if line.product.stock is not null %}max="{{ line.product.stock }}"{% endif %}>
                                <button type="submit">Mettre à jour</button>
                            </form>
                        </td>
                        <td>{{ line.totalCents|price }}</td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr><th colspan="3">Total</th><th>{{ totalCents|price }}</th></tr>
            </tfoot>
        </table>

        <form method="post" action="{{ path('checkout') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">
            <button class="button" type="submit">Payer la commande</button>
        </form>
    {% endif %}
{% endblock %}
