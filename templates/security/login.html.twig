{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <h1>Connexion à l'administration</h1>

    {% if error %}
        <p class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
    {% endif %}

    <form method="post" class="login">
        <label>E-mail
            <input type="email" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
        </label>
        <label>Mot de passe
            <input type="password" name="_password" autocomplete="current-password" required>
        </label>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="button" type="submit">Se connecter</button>
    </form>
{% endblock %}
